# CLASS WEB ENVIRONMENT CONFIGURATION
PORT=5000
JWT_SECRET=super-secret-jwt-key-srmap-csed-portal-2024

# Supabase Configuration (Optional - for direct cloud database connection)
# You can get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Classroom & Drive API Configuration (OAuth 2.0)
# Get these from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://cybex-d-portal.vercel.app/api/classroom/oauth-callback

# Email / SMTP Configuration for OTPs (e.g. Brevo or Gmail App Password)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-password
EMAIL_FROM=cr.csed@srmap.edu.in

